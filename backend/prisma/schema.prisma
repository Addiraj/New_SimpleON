// SimpleOn Protocol Prisma Schema for MySQL
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum LevelStatus {
  ACTIVE
  INACTIVE
  DEPRECATED
}

enum UserLevelStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ReferralStatus {
  ACTIVE
  INACTIVE
}

enum MatrixCycleStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PlacementSource {
  DIRECT
  SPILLOVER
  RECYCLE
}

enum PositionStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentType {
  JOIN
  UPGRADE
  RETOPUP
}

enum PaymentIntentStatus {
  PENDING
  PROCESSING
  CONFIRMED
  FAILED
  EXPIRED
  CANCELLED
}

enum VerificationStatus {
  PENDING
  CONFIRMED
  REJECTED
  FAILED
}

enum TransactionType {
  PLAN_JOIN
  MATRIX_REWARD
  REFERRAL_REWARD
  UPGRADE
  RETOPUP
  CAPPING
  DEPOSIT
  WITHDRAWAL
  REVERSAL
  BOOSTER_REWARD
  ADMIN_INCOME
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVERSED
}

enum LedgerEntryType {
  PLAN_JOIN
  MATRIX_REWARD
  REFERRAL_REWARD
  RETOPUP_DEBIT
  UPGRADE_DEBIT
  CAPPED_INCOME
  HELD_INCOME
  RELEASED_INCOME
  DEPOSIT
  WITHDRAWAL
  REVERSAL
  ADMIN_ADJUSTMENT
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

enum LedgerStatus {
  PENDING
  AVAILABLE
  LOCKED
  COMPLETED
  REVERSED
  FAILED
}

enum DailyEarningStatus {
  ACTIVE
  FINALIZED
  LOCKED
}

enum CappingHandlingType {
  HELD
  FORFEITED
  CARRIED_FORWARD
}

enum UpgradeType {
  AUTOMATIC
  MANUAL
  PAID
}

enum UpgradeStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum NotificationType {
  LOGIN_SUCCESS
  PLAN_ACTIVATED
  PAYMENT_CONFIRMED
  PAYMENT_FAILED
  MATRIX_POSITION_FILLED
  MATRIX_CYCLE_COMPLETED
  LEVEL_UPGRADED
  SYSTEM
}

enum IdempotencyStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ==========================================
// 1. USERS
// ==========================================

model User {
  id               String      @id @default(uuid())
  wallet_address   String      @unique @map("wallet_address") @db.VarChar(255)
  referral_code    String      @unique @map("referral_code") @db.VarChar(64)
  sponsor_id       String?     @map("sponsor_id")
  role             UserRole    @default(USER)
  status           UserStatus  @default(PENDING)
  current_level_id String?     @map("current_level_id")
  display_name     String?     @map("display_name") @db.VarChar(128)
  email            String?     @map("email") @db.VarChar(255)
  joined_at        DateTime?   @map("joined_at")
  last_login_at    DateTime?   @map("last_login_at")
  created_at       DateTime    @default(now()) @map("created_at")
  updated_at       DateTime    @updatedAt @map("updated_at")
  deleted_at       DateTime?   @map("deleted_at")

  // Relations
  sponsor                   User?                @relation("UserSponsor", fields: [sponsor_id], references: [id], onDelete: SetNull)
  sponsored_users           User[]               @relation("UserSponsor")
  current_level             LevelConfiguration?  @relation("UserCurrentLevel", fields: [current_level_id], references: [id], onDelete: SetNull)
  
  nonces                    AuthNonce[]
  sessions                  UserSession[]
  user_levels               UserLevel[]
  sponsor_referrals         ReferralRelation[]   @relation("ReferralSponsor")
  referred_referrals        ReferralRelation[]   @relation("ReferralReferred")
  matrix_cycles             MatrixCycle[]
  member_positions          MatrixPosition[]     @relation("PositionMember")
  sponsor_positions         MatrixPosition[]     @relation("PositionSponsor")
  payment_intents           PaymentIntent[]
  transactions              Transaction[]
  wallet_ledgers            WalletLedger[]
  daily_earnings            DailyEarning[]
  daily_cappings            DailyCapping[]
  upgrade_histories         UpgradeHistory[]
  notifications             Notification[]
  user_preferences          UserPreference?
  audit_logs                AuditLog[]           @relation("AuditLogUser")
  admin_audit_logs          AuditLog[]           @relation("AuditLogAdmin")
  idempotency_keys          IdempotencyKey[]
  booster_wallet            BoosterWallet?

  @@index([wallet_address])
  @@index([referral_code])
  @@index([sponsor_id])
  @@index([current_level_id])
  @@map("users")
}

// ==========================================
// 2. AUTH NONCES
// ==========================================

model AuthNonce {
  id             String    @id @default(uuid())
  user_id        String?   @map("user_id")
  wallet_address String    @map("wallet_address") @db.VarChar(255)
  nonce_hash     String    @map("nonce_hash") @db.VarChar(255)
  message        String    @map("message") @db.Text
  expires_at     DateTime  @map("expires_at")
  used_at        DateTime? @map("used_at")
  created_at     DateTime  @default(now()) @map("created_at")

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([wallet_address])
  @@index([user_id])
  @@map("auth_nonces")
}

// ==========================================
// 3. USER SESSIONS
// ==========================================

model UserSession {
  id                 String    @id @default(uuid())
  user_id            String    @map("user_id")
  refresh_token_hash String    @map("refresh_token_hash") @db.VarChar(255)
  expires_at         DateTime  @map("expires_at")
  revoked_at         DateTime? @map("revoked_at")
  ip_address         String?   @map("ip_address") @db.VarChar(64)
  user_agent         String?   @map("user_agent") @db.Text
  created_at         DateTime  @default(now()) @map("created_at")
  updated_at         DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("user_sessions")
}

// ==========================================
// 4. LEVEL CONFIGURATIONS
// ==========================================

model LevelConfiguration {
  id                           String      @id @default(uuid())
  name                         String      @map("name") @db.VarChar(128)
  slug                         String      @map("slug") @db.VarChar(128)
  level_order                  Int         @map("level_order")
  joining_amount               Decimal     @map("joining_amount") @db.Decimal(20, 8)
  upgrade_amount               Decimal     @map("upgrade_amount") @db.Decimal(20, 8)
  matrix_size                  Int         @default(5) @map("matrix_size")
  income_per_position         Decimal     @map("income_per_position") @db.Decimal(20, 8)
  cycle_reward                 Decimal     @map("cycle_reward") @db.Decimal(20, 8)
  retopup_amount               Decimal     @map("retopup_amount") @db.Decimal(20, 8)
  daily_cap                    Decimal     @map("daily_cap") @db.Decimal(20, 8)
  daily_cycle_limit            Int         @default(5) @map("daily_cycle_limit")
  required_direct_referrals    Int         @default(0) @map("required_direct_referrals")
  required_qualified_builders Int         @default(0) @map("required_qualified_builders")
  auto_upgrade_enabled         Boolean     @default(true) @map("auto_upgrade_enabled")
  retopup_enabled              Boolean     @default(true) @map("retopup_enabled")
  status                       LevelStatus @default(ACTIVE) @map("status")
  version                      Int         @default(1) @map("version")
  effective_from               DateTime    @default(now()) @map("effective_from")
  effective_to                 DateTime?   @map("effective_to")
  created_at                   DateTime    @default(now()) @map("created_at")
  updated_at                   DateTime    @updatedAt @map("updated_at")

  // Relations
  users                     User[]             @relation("UserCurrentLevel")
  user_levels               UserLevel[]
  matrix_cycles             MatrixCycle[]
  payment_intents           PaymentIntent[]
  daily_cappings            DailyCapping[]
  from_upgrade_histories    UpgradeHistory[]   @relation("UpgradeFromLevel")
  to_upgrade_histories      UpgradeHistory[]   @relation("UpgradeToLevel")

  @@unique([name, version])
  @@unique([slug, version])
  @@unique([level_order, version])
  @@map("level_configurations")
}

// ==========================================
// 5. USER LEVELS
// ==========================================

model UserLevel {
  id                     String          @id @default(uuid())
  user_id                String          @map("user_id")
  level_configuration_id String          @map("level_configuration_id")
  status                 UserLevelStatus @default(PENDING) @map("status")
  activated_at           DateTime?       @map("activated_at")
  completed_at           DateTime?       @map("completed_at")
  configuration_snapshot Json?           @map("configuration_snapshot")
  created_at             DateTime        @default(now()) @map("created_at")
  updated_at             DateTime        @updatedAt @map("updated_at")

  user                User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  level_configuration LevelConfiguration @relation(fields: [level_configuration_id], references: [id])

  @@index([user_id])
  @@index([level_configuration_id])
  @@unique([user_id, level_configuration_id])
  @@map("user_levels")
}

// ==========================================
// 6. REFERRAL RELATIONS
// ==========================================

model ReferralRelation {
  id               String         @id @default(uuid())
  sponsor_user_id  String         @map("sponsor_user_id")
  referred_user_id String         @map("referred_user_id")
  depth            Int            @default(1) @map("depth")
  status           ReferralStatus @default(ACTIVE) @map("status")
  created_at       DateTime       @default(now()) @map("created_at")

  sponsor  User @relation("ReferralSponsor", fields: [sponsor_user_id], references: [id], onDelete: Cascade)
  referred User @relation("ReferralReferred", fields: [referred_user_id], references: [id], onDelete: Cascade)

  @@unique([sponsor_user_id, referred_user_id])
  @@index([sponsor_user_id])
  @@index([referred_user_id])
  @@map("referral_relations")
}

// ==========================================
// 7. MATRIX CYCLES
// ==========================================

model MatrixCycle {
  id                     String            @id @default(uuid())
  user_id                String            @map("user_id")
  level_configuration_id String            @map("level_configuration_id")
  cycle_number           Int               @default(1) @map("cycle_number")
  total_positions       Int               @default(5) @map("total_positions")
  filled_positions      Int               @default(0) @map("filled_positions")
  status                 MatrixCycleStatus @default(ACTIVE) @map("status")
  previous_cycle_id      String?           @map("previous_cycle_id")
  next_cycle_id          String?           @map("next_cycle_id")
  configuration_snapshot Json?             @map("configuration_snapshot")
  started_at             DateTime          @default(now()) @map("started_at")
  completed_at           DateTime?         @map("completed_at")
  created_at             DateTime          @default(now()) @map("created_at")
  updated_at             DateTime          @updatedAt @map("updated_at")

  user                User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  level_configuration LevelConfiguration @relation(fields: [level_configuration_id], references: [id])
  previous_cycle      MatrixCycle?       @relation("CycleSequence", fields: [previous_cycle_id], references: [id], onDelete: SetNull)
  next_cycles         MatrixCycle[]      @relation("CycleSequence")
  positions           MatrixPosition[]

  @@unique([user_id, level_configuration_id, cycle_number])
  @@index([user_id])
  @@index([level_configuration_id])
  @@map("matrix_cycles")
}

// ==========================================
// 8. MATRIX POSITIONS
// ==========================================

model MatrixPosition {
  id               String          @id @default(uuid())
  matrix_cycle_id  String          @map("matrix_cycle_id")
  position_number  Int             @map("position_number")
  member_user_id   String          @map("member_user_id")
  sponsor_user_id  String          @map("sponsor_user_id")
  placement_source PlacementSource @default(DIRECT) @map("placement_source")
  status           PositionStatus  @default(CONFIRMED) @map("status")
  placed_at        DateTime        @default(now()) @map("placed_at")
  created_at       DateTime        @default(now()) @map("created_at")

  matrix_cycle MatrixCycle @relation(fields: [matrix_cycle_id], references: [id], onDelete: Cascade)
  member_user  User        @relation("PositionMember", fields: [member_user_id], references: [id])
  sponsor_user User        @relation("PositionSponsor", fields: [sponsor_user_id], references: [id])

  @@unique([matrix_cycle_id, position_number])
  @@index([matrix_cycle_id])
  @@index([member_user_id])
  @@index([sponsor_user_id])
  @@map("matrix_positions")
}

// ==========================================
// 9. PAYMENT INTENTS
// ==========================================

model PaymentIntent {
  id                     String              @id @default(uuid())
  user_id                String              @map("user_id")
  level_configuration_id String?             @map("level_configuration_id")
  payment_reference      String              @unique @map("payment_reference") @db.VarChar(128)
  payment_type           PaymentType         @map("payment_type")
  expected_amount        Decimal             @map("expected_amount") @db.Decimal(20, 8)
  token_address          String?             @map("token_address") @db.VarChar(255)
  receiver_address       String?             @map("receiver_address") @db.VarChar(255)
  network_id             String?             @map("network_id") @db.VarChar(64)
  status                 PaymentIntentStatus @default(PENDING) @map("status")
  expires_at             DateTime            @map("expires_at")
  metadata               Json?               @map("metadata")
  created_at             DateTime            @default(now()) @map("created_at")
  updated_at             DateTime            @updatedAt @map("updated_at")

  user                User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  level_configuration LevelConfiguration? @relation(fields: [level_configuration_id], references: [id], onDelete: SetNull)
  verifications       PaymentVerification[]
  transactions        Transaction[]

  @@index([user_id])
  @@index([payment_reference])
  @@map("payment_intents")
}

// ==========================================
// 10. PAYMENT VERIFICATIONS
// ==========================================

model PaymentVerification {
  id                 String             @id @default(uuid())
  payment_intent_id  String             @map("payment_intent_id")
  transaction_hash   String             @unique @map("transaction_hash") @db.VarChar(255)
  from_address       String             @map("from_address") @db.VarChar(255)
  to_address         String             @map("to_address") @db.VarChar(255)
  token_address      String?            @map("token_address") @db.VarChar(255)
  network_id         String?            @map("network_id") @db.VarChar(64)
  block_number       BigInt?            @map("block_number")
  confirmed_amount   Decimal            @map("confirmed_amount") @db.Decimal(20, 8)
  confirmation_count Int                @default(1) @map("confirmation_count")
  status             VerificationStatus @default(CONFIRMED) @map("status")
  failure_reason     String?            @map("failure_reason") @db.Text
  raw_receipt        Json?              @map("raw_receipt")
  verified_at        DateTime?          @map("verified_at")
  created_at         DateTime           @default(now()) @map("created_at")
  updated_at         DateTime           @updatedAt @map("updated_at")

  payment_intent PaymentIntent @relation(fields: [payment_intent_id], references: [id], onDelete: Cascade)

  @@index([payment_intent_id])
  @@index([transaction_hash])
  @@map("payment_verifications")
}

// ==========================================
// 11. TRANSACTIONS
// ==========================================

model Transaction {
  id                          String            @id @default(uuid())
  user_id                     String            @map("user_id")
  payment_intent_id           String?           @map("payment_intent_id")
  transaction_type            TransactionType   @map("transaction_type")
  amount                      Decimal           @map("amount") @db.Decimal(20, 8)
  currency                    String            @default("USDT") @map("currency") @db.VarChar(32)
  blockchain_transaction_hash String?           @unique @map("blockchain_transaction_hash") @db.VarChar(255)
  status                      TransactionStatus @default(PENDING) @map("status")
  description                 String?           @map("description") @db.Text
  metadata                    Json?             @map("metadata")
  created_at                  DateTime          @default(now()) @map("created_at")
  updated_at                  DateTime          @updatedAt @map("updated_at")
  completed_at                DateTime?         @map("completed_at")

  user              User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  payment_intent    PaymentIntent?     @relation(fields: [payment_intent_id], references: [id], onDelete: SetNull)
  wallet_ledgers    WalletLedger[]
  upgrade_histories UpgradeHistory[]

  @@index([user_id])
  @@index([status])
  @@index([created_at])
  @@map("transactions")
}

// ==========================================
// 12. WALLET LEDGERS
// ==========================================

model WalletLedger {
  id               String          @id @default(uuid())
  user_id          String          @map("user_id")
  transaction_id   String?         @map("transaction_id")
  entry_type       LedgerEntryType @map("entry_type")
  direction        LedgerDirection @map("direction")
  amount           Decimal         @map("amount") @db.Decimal(20, 8)
  available_amount Decimal         @default(0) @map("available_amount") @db.Decimal(20, 8)
  locked_amount    Decimal         @default(0) @map("locked_amount") @db.Decimal(20, 8)
  pending_amount   Decimal         @default(0) @map("pending_amount") @db.Decimal(20, 8)
  status           LedgerStatus    @default(AVAILABLE) @map("status")
  idempotency_key  String          @unique @map("idempotency_key") @db.VarChar(255)
  source_type      String?         @map("source_type") @db.VarChar(128)
  source_id        String?         @map("source_id") @db.VarChar(255)
  metadata         Json?           @map("metadata")
  created_at       DateTime        @default(now()) @map("created_at")

  user        User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transaction_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([transaction_id])
  @@index([idempotency_key])
  @@map("wallet_ledgers")
}

// ==========================================
// 13. DAILY EARNINGS
// ==========================================

model DailyEarning {
  id                     String             @id @default(uuid())
  user_id                String             @map("user_id")
  business_date          DateTime           @map("business_date") @db.Date
  gross_amount           Decimal            @default(0) @map("gross_amount") @db.Decimal(20, 8)
  credited_amount        Decimal            @default(0) @map("credited_amount") @db.Decimal(20, 8)
  capped_amount          Decimal            @default(0) @map("capped_amount") @db.Decimal(20, 8)
  held_amount            Decimal            @default(0) @map("held_amount") @db.Decimal(20, 8)
  carried_forward_amount Decimal            @default(0) @map("carried_forward_amount") @db.Decimal(20, 8)
  daily_cap              Decimal            @map("daily_cap") @db.Decimal(20, 8)
  timezone               String             @default("UTC") @map("timezone") @db.VarChar(64)
  status                 DailyEarningStatus @default(ACTIVE) @map("status")
  created_at             DateTime           @default(now()) @map("created_at")
  updated_at             DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, business_date])
  @@index([user_id])
  @@index([business_date])
  @@map("daily_earnings")
}

// ==========================================
// 14. DAILY CAPPINGS
// ==========================================

model DailyCapping {
  id                       String              @id @default(uuid())
  user_id                  String              @map("user_id")
  level_configuration_id   String              @map("level_configuration_id")
  business_date            DateTime            @map("business_date") @db.Date
  gross_earning            Decimal             @default(0) @map("gross_earning") @db.Decimal(20, 8)
  allowed_earning          Decimal             @default(0) @map("allowed_earning") @db.Decimal(20, 8)
  excess_earning           Decimal             @default(0) @map("excess_earning") @db.Decimal(20, 8)
  handling_type            CappingHandlingType @default(HELD) @map("handling_type")
  qualified_builder_count Int                 @default(0) @map("qualified_builder_count")
  completed_cycle_count   Int                 @default(0) @map("completed_cycle_count")
  daily_cycle_limit       Int                 @default(5) @map("daily_cycle_limit")
  capped_cycle_count      Int                 @default(0) @map("capped_cycle_count")
  calculation_snapshot     Json?               @map("calculation_snapshot")
  finalized_at             DateTime?           @map("finalized_at")
  created_at               DateTime            @default(now()) @map("created_at")
  updated_at               DateTime            @updatedAt @map("updated_at")

  user                User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  level_configuration LevelConfiguration @relation(fields: [level_configuration_id], references: [id])

  @@unique([user_id, level_configuration_id, business_date])
  @@index([user_id])
  @@index([business_date])
  @@map("daily_cappings")
}

// ==========================================
// 15. UPGRADE HISTORIES
// ==========================================

model UpgradeHistory {
  id                   String        @id @default(uuid())
  user_id              String        @map("user_id")
  from_level_id        String?       @map("from_level_id")
  to_level_id          String        @map("to_level_id")
  upgrade_type         UpgradeType   @map("upgrade_type")
  status               UpgradeStatus @default(PENDING) @map("status")
  amount               Decimal       @map("amount") @db.Decimal(20, 8)
  eligibility_snapshot Json?         @map("eligibility_snapshot")
  transaction_id       String?       @map("transaction_id")
  idempotency_key      String?       @unique @map("idempotency_key") @db.VarChar(255)
  upgraded_at          DateTime?     @map("upgraded_at")
  created_at           DateTime      @default(now()) @map("created_at")
  updated_at           DateTime      @updatedAt @map("updated_at")

  user        User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  from_level  LevelConfiguration? @relation("UpgradeFromLevel", fields: [from_level_id], references: [id], onDelete: SetNull)
  to_level    LevelConfiguration  @relation("UpgradeToLevel", fields: [to_level_id], references: [id])
  transaction Transaction?        @relation(fields: [transaction_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([to_level_id])
  @@map("upgrade_histories")
}

// ==========================================
// 16. NOTIFICATIONS
// ==========================================

model Notification {
  id         String           @id @default(uuid())
  user_id    String           @map("user_id")
  type       NotificationType @map("type")
  title      String           @map("title") @db.VarChar(255)
  message    String           @map("message") @db.Text
  data       Json?            @map("data")
  is_read    Boolean          @default(false) @map("is_read")
  read_at    DateTime?        @map("read_at")
  created_at DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, is_read, created_at])
  @@index([user_id])
  @@map("notifications")
}

// ==========================================
// 17. USER PREFERENCES
// ==========================================

model UserPreference {
  id                    String   @id @default(uuid())
  user_id               String   @unique @map("user_id")
  email_notifications   Boolean  @default(true) @map("email_notifications")
  in_app_notifications  Boolean  @default(true) @map("in_app_notifications")
  language              String   @default("en") @map("language") @db.VarChar(16)
  theme                 String   @default("dark") @map("theme") @db.VarChar(32)
  created_at            DateTime @default(now()) @map("created_at")
  updated_at            DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// ==========================================
// 18. AUDIT LOGS
// ==========================================

model AuditLog {
  id            String   @id @default(uuid())
  user_id       String?  @map("user_id")
  admin_user_id String?  @map("admin_user_id")
  action        String   @map("action") @db.VarChar(128)
  entity_type   String   @map("entity_type") @db.VarChar(128)
  entity_id     String?  @map("entity_id") @db.VarChar(255)
  old_values    Json?    @map("old_values")
  new_values    Json?    @map("new_values")
  ip_address    String?  @map("ip_address") @db.VarChar(64)
  user_agent    String?  @map("user_agent") @db.Text
  created_at    DateTime @default(now()) @map("created_at")

  user       User? @relation("AuditLogUser", fields: [user_id], references: [id], onDelete: SetNull)
  admin_user User? @relation("AuditLogAdmin", fields: [admin_user_id], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([entity_type])
  @@index([created_at])
  @@map("audit_logs")
}

// ==========================================
// 19. IDEMPOTENCY KEYS
// ==========================================

model IdempotencyKey {
  id            String            @id @default(uuid())
  key           String            @unique @map("key") @db.VarChar(255)
  user_id       String?           @map("user_id")
  operation     String            @map("operation") @db.VarChar(128)
  request_hash  String            @map("request_hash") @db.VarChar(255)
  response_data Json?             @map("response_data")
  status        IdempotencyStatus @default(PENDING) @map("status")
  expires_at    DateTime          @map("expires_at")
  created_at    DateTime          @default(now()) @map("created_at")
  updated_at    DateTime          @updatedAt @map("updated_at")

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([key])
  @@index([user_id])
  @@map("idempotency_keys")
}

// ==========================================
// 20. SYSTEM CONFIGURATIONS
// ==========================================

model SystemConfiguration {
  id                  String   @id @default(uuid())
  configuration_key   String   @unique @map("configuration_key") @db.VarChar(128)
  configuration_value String   @map("configuration_value") @db.Text
  value_type          String   @default("STRING") @map("value_type") @db.VarChar(32)
  is_public           Boolean  @default(false) @map("is_public")
  description         String?  @map("description") @db.Text
  created_at          DateTime @default(now()) @map("created_at")
  updated_at          DateTime @updatedAt @map("updated_at")

  @@map("system_configurations")
}

// ==========================================
// 21. BOOSTER WALLETS
// ==========================================

model BoosterWallet {
  id                        String   @id @default(uuid())
  user_id                   String   @unique @map("user_id")
  starter_resubscribe_fund  Decimal  @default(0) @map("starter_resubscribe_fund") @db.Decimal(20, 8)
  builder_activation_fund   Decimal  @default(0) @map("builder_activation_fund") @db.Decimal(20, 8)
  builder_resubscribe_fund  Decimal  @default(0) @map("builder_resubscribe_fund") @db.Decimal(20, 8)
  leader_activation_fund    Decimal  @default(0) @map("leader_activation_fund") @db.Decimal(20, 8)
  leader_resubscribe_fund   Decimal  @default(0) @map("leader_resubscribe_fund") @db.Decimal(20, 8)
  champion_activation_fund  Decimal  @default(0) @map("champion_activation_fund") @db.Decimal(20, 8)
  champion_resubscribe_fund Decimal  @default(0) @map("champion_resubscribe_fund") @db.Decimal(20, 8)
  b_titan_reserve_fund      Decimal  @default(0) @map("b_titan_reserve_fund") @db.Decimal(20, 8)
  main_plan_reserve_fund    Decimal  @default(0) @map("main_plan_reserve_fund") @db.Decimal(20, 8)
  income_wallet             Decimal  @default(0) @map("income_wallet") @db.Decimal(20, 8)
  
  current_highest_pool      String   @default("STARTER") @map("current_highest_pool") @db.VarChar(32)

  starter_cycle             Int      @default(1) @map("starter_cycle")
  builder_cycle             Int      @default(1) @map("builder_cycle")
  leader_cycle              Int      @default(1) @map("leader_cycle")
  champion_cycle            Int      @default(1) @map("champion_cycle")
  
  starter_members_count     Int      @default(0) @map("starter_members_count")
  builder_members_count     Int      @default(0) @map("builder_members_count")
  leader_members_count      Int      @default(0) @map("leader_members_count")
  champion_members_count    Int      @default(0) @map("champion_members_count")

  created_at                DateTime @default(now()) @map("created_at")
  updated_at                DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("booster_wallets")
}

// ==========================================
// 22. ADMIN WALLETS
// ==========================================

model AdminWallet {
  id            String   @id @default("ADMIN")
  total_income  Decimal  @default(0) @map("total_income") @db.Decimal(20, 8)
  created_at    DateTime @default(now()) @map("created_at")
  updated_at    DateTime @updatedAt @map("updated_at")

  @@map("admin_wallets")
}
